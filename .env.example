# Copy to .env, replace placeholders, then load with: set -a; . ./.env; set +a
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_FRONTEND_ORIGIN=http://localhost:5173
DJANGO_PASSWORD_RESET_TIMEOUT=3600

POSTGRES_DB=fitness_dev
POSTGRES_USER=fitness_app
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Local only: print password reset e-mails to the runserver console
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Trusted reverse proxies in front of Django (0 = ignore client X-Forwarded-For)
DJANGO_NUM_PROXIES=0
